# ---------------------------------------------------------------
# 資料庫
# 開發階段使用 SQLite，零設定即可啟動。
# 正式環境改為 PostgreSQL：
#   1. 將 prisma/schema.prisma 的 provider 改為 "postgresql"
#   2. DATABASE_URL 改為 postgresql://user:password@host:5432/dbname
# ---------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------
# 本地 LLM（Ollama）
# 所有推論都在內網進行，不呼叫任何公有雲 API。
# 安裝：https://ollama.com  然後執行 ollama pull qwen2.5:7b-instruct
# ---------------------------------------------------------------
OLLAMA_URL="http://127.0.0.1:11434"
LLM_MODEL="qwen2.5:7b-instruct"

# ---------------------------------------------------------------
# 系統對外網址（用於產生候選人面試連結）
# ---------------------------------------------------------------
APP_BASE_URL="http://localhost:3000"

# ---------------------------------------------------------------
# Email（公司內部 SMTP）
# 未設定時，系統會將信件內容輸出到終端機，方便開發階段測試。
# ---------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="recruiting@example.com"
MAIL_FROM_NAME="招募團隊"
